<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>VPin.Inspector</RootNamespace>
    <AssemblyName>VPinInspector</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Core\VPinInspector.Core.csproj" />
    <None Include="VpsMatchAssistant\VpsMatchAssistant.csproj" />
    <None Include="VpsShared\VpsShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="OpenMcdf" Version="3.2.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- Core is compiled by its own class library; exclude it from the app glob. -->
  <ItemGroup>
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="VpsShared\**\*.cs" />
    <Compile Remove="VpsMatchAssistant\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\VPinInspector.Core.csproj" />
    <ProjectReference Include="VpsShared\VpsShared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
